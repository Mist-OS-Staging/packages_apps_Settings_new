<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hyper_mod"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.mist.utils.MistHeroLayout
        android:id="@+id/hero_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/mist_about_hero_bg"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:contentDescription="@string/mist_about_switch_header">

        <com.mist.utils.AnimateWallpaperView
            android:id="@+id/hero_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mist_about_hero_scrim" />

        <RelativeLayout
            android:id="@+id/header_device"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/mist_build_type"
                style="@style/MistAbout.Chip"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true" />

            <ImageView
                android:id="@+id/hero_logo"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitCenter"
                android:src="@drawable/mist_logo"
                android:tint="@android:color/white"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/device_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:textSize="14sp"
                android:textColor="#E0FFFFFF"
                android:singleLine="true"
                android:ellipsize="end"
                android:shadowColor="#40000000"
                android:shadowRadius="8" />

            <TextView
                android:id="@+id/device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/device_model"
                android:layout_marginEnd="40dp"
                android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                android:textSize="26sp"
                android:textColor="@android:color/white"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="0.95"
                android:shadowColor="#40000000"
                android:shadowRadius="10" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/header_brand"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:weightSum="1"
            android:padding="16dp"
            android:visibility="gone"
            android:alpha="0">

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/mist_header_logo"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/brand_version"
                    style="@style/MistAbout.Chip"
                    android:paddingStart="12dp"
                    android:background="@drawable/mist_about_glass_chip_bg"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/brand_build_type"
                    style="@style/MistAbout.Chip"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/hero_swap"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:padding="7dp"
            android:background="@drawable/mist_about_swap_bg"
            android:src="@drawable/mist_about_ic_swap"
            android:tint="@android:color/white"
            android:importantForAccessibility="no" />
    </com.mist.utils.MistHeroLayout>

    <LinearLayout
        android:id="@+id/identity_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/mist_about_identity_bg">

        <LinearLayout
            android:id="@+id/identity_mist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                style="@style/MistAbout.IdentityBadge"
                android:padding="14dp"
                android:background="@drawable/mist_about_shape_sunny"
                android:src="@drawable/mist_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mist_about_mist_version"
                    android:fontFamily="@*android:string/config_bodyFontFamilyMedium"
                    android:textSize="12sp"
                    android:alpha="0.78"
                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/mist_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                        android:textSize="22sp"
                        android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/mist_codename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@*android:string/config_bodyFontFamilyMedium"
                        android:textSize="14sp"
                        android:alpha="0.8"
                        android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/identity_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                style="@style/MistAbout.IdentityBadge"
                android:padding="14dp"
                android:background="@drawable/mist_about_shape_cookie4"
                android:src="@drawable/mist_about_ic_device" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/identity_device_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_bodyFontFamilyMedium"
                    android:textSize="12sp"
                    android:alpha="0.78"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/identity_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                    android:textSize="22sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:alpha="0.14"
            android:background="@color/settingslib_materialColorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/maintainer_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/mist_about_avatar"
                android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                android:textSize="15sp"
                android:textColor="@color/settingslib_materialColorOnTertiaryContainer"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mist_about_maintainer"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:textSize="12sp"
                    android:alpha="0.78"
                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/mantainer_about"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/settingslib_materialColorOnPrimaryContainer" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:clipChildren="false">

        <FrameLayout
            android:id="@+id/android_bar_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mist_about_tile_android"
            android:clipToOutline="true"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/android_decor"
                style="@style/MistAbout.TileDecor"
                android:src="@drawable/mist_about_shape_cookie" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="156dp"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/android_shape"
                    style="@style/MistAbout.TileShape"
                    android:background="@drawable/mist_about_shape_cookie"
                    android:src="@drawable/mist_about_ic_android" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/MistAbout.TileCaption"
                    android:text="@string/mist_about_android_version" />

                <TextView
                    android:id="@+id/android_version"
                    style="@style/MistAbout.TileValue" />

                <TextView
                    android:id="@+id/android_codename"
                    style="@style/MistAbout.TileCaption"
                    android:text="@string/mist_about_android_dessert" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/device_bar_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/mist_about_tile_security"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/security_decor"
                style="@style/MistAbout.TileDecor"
                android:src="@drawable/mist_about_shape_clover" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="156dp"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/security_shape"
                    style="@style/MistAbout.TileShape"
                    android:background="@drawable/mist_about_shape_clover"
                    android:src="@drawable/mist_about_ic_shield" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/MistAbout.TileCaption"
                    android:text="@string/mist_about_security_update" />

                <TextView
                    android:id="@+id/security_update"
                    style="@style/MistAbout.TileValue" />

                <TextView
                    android:id="@+id/security_update_year"
                    style="@style/MistAbout.TileCaption" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        style="@style/MistAbout.SectionHeader"
        android:text="@string/mist_about_memory_storage" />

    <LinearLayout
        android:id="@+id/storage_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/mist_about_panel_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                style="@style/MistAbout.IconCircle"
                android:src="@drawable/mist_about_ic_ram" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/MistAbout.TwoLineTitle"
                    android:text="@string/mist_about_ram" />

                <TextView
                    android:id="@+id/ram_about"
                    style="@style/MistAbout.TwoLineSummary"
                    android:layout_marginTop="0dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ram_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                android:textSize="15sp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/settingslib_materialColorPrimary" />
        </LinearLayout>

        <com.mist.utils.WavyProgressView
            android:id="@+id/ram_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                style="@style/MistAbout.IconCircle"
                android:src="@drawable/mist_about_ic_storage" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/MistAbout.TwoLineTitle"
                    android:text="@string/mist_about_storage" />

                <TextView
                    android:id="@+id/storage_about"
                    style="@style/MistAbout.TwoLineSummary"
                    android:layout_marginTop="0dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/storage_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                android:textSize="15sp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/settingslib_materialColorPrimary" />
        </LinearLayout>

        <com.mist.utils.WavyProgressView
            android:id="@+id/rom_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <TextView
        style="@style/MistAbout.SectionHeader"
        android:text="@string/mist_about_specifications" />

    <LinearLayout
        android:id="@+id/spec_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/MistAbout.ListRow"
            android:layout_marginTop="0dp"
            android:background="@drawable/mist_about_list_top">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_chip" />
            <TextView style="@style/MistAbout.ListKey" android:text="@string/text_processor" />
            <TextView android:id="@+id/soc_about" style="@style/MistAbout.ListValue" />
        </LinearLayout>

        <LinearLayout style="@style/MistAbout.ListRow">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_board" />
            <TextView style="@style/MistAbout.ListKey" android:text="@string/platform_title" />
            <TextView android:id="@+id/platform_about" style="@style/MistAbout.ListValue" />
        </LinearLayout>

        <LinearLayout style="@style/MistAbout.ListRow">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_resolution" />
            <TextView style="@style/MistAbout.ListKey" android:text="@string/text_display" />
            <TextView android:id="@+id/resolution_about" style="@style/MistAbout.ListValue" />
        </LinearLayout>

        <LinearLayout style="@style/MistAbout.ListRow">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_phone" />
            <TextView style="@style/MistAbout.ListKey" android:text="@string/screen_size" />
            <TextView android:id="@+id/screen_about" style="@style/MistAbout.ListValue" />
        </LinearLayout>

        <LinearLayout style="@style/MistAbout.ListRow">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_battery" />
            <TextView style="@style/MistAbout.ListKey" android:text="@string/mist_about_battery" />
            <TextView android:id="@+id/battery_about" style="@style/MistAbout.ListValue" />
        </LinearLayout>

        <LinearLayout style="@style/MistAbout.ListRow">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_camera" />
            <TextView style="@style/MistAbout.ListKey" android:text="@string/text_camera_rear" />
            <TextView android:id="@+id/rear_camera_about" style="@style/MistAbout.ListValue" />
        </LinearLayout>

        <LinearLayout style="@style/MistAbout.ListRow"
            android:background="@drawable/mist_about_list_bottom">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_camera_front" />
            <TextView style="@style/MistAbout.ListKey" android:text="@string/front_camer" />
            <TextView android:id="@+id/front_camera_about" style="@style/MistAbout.ListValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/MistAbout.SectionHeader"
        android:text="@string/mist_about_build" />

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/MistAbout.ListRow"
            android:layout_marginTop="0dp"
            android:gravity="top"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/mist_about_list_top">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_calendar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
                <TextView style="@style/MistAbout.TwoLineTitle" android:text="@string/build_date" />
                <TextView android:id="@+id/build_date" style="@style/MistAbout.TwoLineSummary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kernel_row"
            style="@style/MistAbout.ListRow"
            android:gravity="top"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_terminal" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
                <TextView style="@style/MistAbout.TwoLineTitle" android:text="@string/mist_about_kernel_version" />
                <TextView android:id="@+id/kernel_version" style="@style/MistAbout.TwoLineSummary" />
            </LinearLayout>
            <ImageView
                android:id="@+id/kernel_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:src="@drawable/mist_about_ic_expand"
                android:tint="@color/settingslib_materialColorOnSurfaceVariant"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout style="@style/MistAbout.ListRow"
            android:gravity="top"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/mist_about_list_bottom">
            <ImageView style="@style/MistAbout.IconCircle" android:src="@drawable/mist_about_ic_tag" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
                <TextView style="@style/MistAbout.TwoLineTitle" android:text="@string/text_build_number" />
                <TextView android:id="@+id/build_number" style="@style/MistAbout.TwoLineSummary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
