<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_homepage_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ff_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="128dp">

            <LinearLayout
                android:id="@+id/app_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                android:paddingTop="@dimen/search_bar_container_top_padding"
                android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">

                <TextView
                    android:id="@+id/homepage_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:paddingBottom="16dp"
                    android:text="@string/settings_label"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="32sp" />

                <View
                    android:id="@+id/ff_search_spacer"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/suggestion_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <com.mist.freeflow.HeroCarouselView
                android:id="@+id/ff_hero"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:layout_marginTop="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <View
                    android:id="@+id/ff_dot_0"
                    android:layout_width="8dp"
                    android:layout_height="8dp" />

                <View
                    android:id="@+id/ff_dot_1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <com.mist.freeflow.FreeFlowGridView
                android:id="@+id/ff_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/ff_status_band"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?android:attr/colorBackground" />

    <LinearLayout
        android:id="@+id/ff_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingTop="4dp"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <include layout="@layout/search_bar" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnMistVersion"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/mist_button_bg"
            android:contentDescription="@string/ff_mist_info"
            android:foreground="@drawable/button_ripple_radius"
            android:padding="5dp"
            android:src="@drawable/logo_single"
            android:tint="@*android:color/accent_device_default" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ff_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible">

        <LinearLayout
            android:id="@+id/ff_top_content"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/ff_top_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_headlineFontFamily"
                android:maxLines="1"
                android:text="@string/ff_edit_shortcuts"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/ff_edit_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ff_edit_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/ff_pill_ripple"
                    android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/ff_reset"
                    android:textColor="@color/settingslib_materialColorPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/ff_edit_done"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/ff_done_bg"
                    android:drawableStart="@drawable/ff_ic_check"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/settingslib_materialColorOnPrimary"
                    android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                    android:foreground="@drawable/ff_pill_ripple"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp"
                    android:text="@string/ff_done"
                    android:textColor="@color/settingslib_materialColorOnPrimary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/ff_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/ff_scrim"
        android:clickable="true"
        android:contentDescription="@string/ff_close_all"
        android:focusable="false"
        android:visibility="gone" />

    <com.mist.freeflow.SheetFrame
        android:id="@+id/ff_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ff_sheet_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        app:layout_behavior="com.mist.freeflow.FreeFlowSheetBehavior">

        <LinearLayout
            android:id="@+id/ff_sheet_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ff_sheet_bg"
            android:elevation="1dp"
            android:outlineProvider="none"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/ff_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:text="@string/ff_all_settings"
                    android:textColor="@color/settingslib_materialColorOnSurface"
                    android:textSize="22sp" />

                <FrameLayout
                    android:id="@+id/ff_sheet_toggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ff_chip_circle_bg"
                    android:contentDescription="@string/ff_open_all"
                    android:focusable="true"
                    android:foreground="@drawable/ff_circle_ripple">

                    <ImageView
                        android:id="@+id/ff_sheet_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ff_ic_chevron_up"
                        android:tint="@color/settingslib_materialColorOnSurface" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/ff_sheet_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0"
            android:background="@color/settingslib_materialColorOutlineVariant" />

        <FrameLayout
            android:id="@+id/ff_all_settings_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true" />

    </com.mist.freeflow.SheetFrame>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
