<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ff_mfy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ff_mfy_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="68dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ff_mfy_hero"
                android:layout_width="match_parent"
                android:layout_height="184dp"
                android:background="@drawable/ff_mfy_hero_bg"
                android:clipToOutline="true"
                android:importantForAccessibility="no">

                <com.mist.freeflow.MorphBadgeView
                    android:id="@+id/ff_mfy_badge"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="-22dp" />

                <LinearLayout
                    android:id="@+id/ff_mfy_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="140dp"
                    android:layout_marginBottom="22dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
                        android:text="@string/ff_hero_customise"
                        android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                        android:textSize="14sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="@*android:string/config_headlineFontFamily"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/ff_mistify"
                        android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                        android:textSize="36sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.85"
                        android:fontFamily="@*android:string/config_bodyFontFamily"
                        android:maxLines="2"
                        android:text="@string/ff_hero_mistify_desc"
                        android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/ff_mfy_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/ff_mfy_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/ff_mfy_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/ff_circle_ripple"
            android:contentDescription="@string/ff_back"
            android:scaleType="center"
            android:src="@drawable/ff_ic_back"
            android:tint="@color/settingslib_materialColorOnSurface" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/ff_mfy_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ff_circle_ripple"
                android:contentDescription="@string/ff_search_settings"
                android:scaleType="center"
                android:src="@drawable/ff_ic_search"
                android:tint="@color/settingslib_materialColorOnSurface" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
